# このファイルを .env にコピーして値を設定する。.env は絶対にgitにコミットしない。
# (.gitignore に .env を必ず追加すること)

# --- AI概況 / カレンダー注釈 (Anthropic) ---
# 未設定なら /api/ai-overview と /api/macro のAI注釈は無効化され、
# フロントはルールベースのフォールバック文へ切り替わる (画面は落ちない)。
ANTHROPIC_API_KEY=ここにキーを貼る
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- 経済カレンダー (Finnhub 無料枠) ---
# 未設定なら経済指標は取得せず、Deribit満期など自前計算イベントのみで /api/macro を返す。
FINNHUB_API_KEY=ここにキーを貼る

# --- Entry Console 連携 ---
# entry_state.json のパス (既存Entry Consoleが出力するファイルを監視)。
# 不在なら /api/entry-state は404を返し、フロントはサンプル+黄タグにフォールバック。
ENTRY_STATE_PATH=entry_state.json

# --- Coinglass Hobbyist のAPIキー (契約後にダッシュボードで発行 / 現方針では未使用) ---
COINGLASS_API_KEY=ここにキーを貼る

# --- Hyperliquid 清算マップ設定 (通常は変更不要) ---
LIQMAP_COIN=BTC
HL_WEIGHT_BUDGET=600
LIQMAP_LEADERBOARD_N=3000
LIQMAP_BIN_PCT=0.0025
LIQMAP_RANGE_PCT=0.15
# メモリ保護: 追跡アドレスの上限。小規模インスタンス(Render Starter=512MB等)では
# 6000程度に下げる。WS収集が無制限にアドレスを貯めるのを止め、OOMを防ぐ。
LIQMAP_MAX_ADDRESSES=8000
# リーダーボードは ijson で逐次パースするためメモリは一定。MAX_MB は帯域の安全弁(0=無制限)。
LIQMAP_LEADERBOARD_MAX_MB=0
